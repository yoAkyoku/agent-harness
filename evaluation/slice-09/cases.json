    {
      "id": "analysis-standard",
      "kind": "analysis",
      "task": "請分析 metrics.csv，計算訂單總數、異常總數及整體異常率（異常數 / 訂單數 × 100），保存為 report.md，附可追溯來源。若缺少必要欄位，明確指出缺少什麼；只計算有證據的數值，不能補零或猜測異常率。",
      "sources": [
        "metrics.csv"
      ],
      "truth": {
        "orders": "240",
        "exceptions": "15",
        "rate": "6.25",
        "numeric_results": [
          "240",
          "15",
          "6.250000"
        ],
        "missing": []
      }
    },
