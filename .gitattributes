# Check out text with LF on every platform, so files hash the same on Windows and Linux.
* text=auto eol=lf

# Evidence and model inputs are byte-exact: recorded runs and evaluation truth pin
# their SHA-256, so never convert line endings in these.
evaluation/** -text
tests/fixtures/** -text
src/agent_harness_demo/demo_sources/** -text
docs/evaluation/records/** -text
docs/validation/** -text
downloads/** -text
